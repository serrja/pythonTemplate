[build-system]
{% if profile == 'native' %}requires = ["scikit-build-core>=0.11,<1", "pybind11>=3,<4"]
build-backend = "scikit_build_core.build"
{% else %}requires = ["hatchling>=1.27,<2"]
build-backend = "hatchling.build"
{% endif %}
[project]
name = "{{ packageName | lower }}"
version = "0.1.0"
description = "{{ projectName }} {{ profile }} foundation"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [{% if profile == 'cli' %}"typer>=0.27,<1"{% elif profile == 'service' %}"fastapi>=0.119,<1", "uvicorn>=0.38,<1", "pydantic-settings>=2.12,<3"{% if withPersistence %}, "sqlalchemy[asyncio]>=2.0.44,<3", "asyncpg>=0.31,<1", "alembic>=1.17,<2"{% endif %}{% endif %}]

{% if profile == 'cli' %}[project.scripts]
{{ projectName }} = "{{ packageName }}.cli:app"

{% endif %}[dependency-groups]
dev = ["mypy>=2.3,<3", "pytest>=9,<10", "pytest-cov>=7,<8", "ruff>=0.16,<1"]

{% if profile != 'native' %}[tool.hatch.build.targets.wheel]
packages = ["src/{{ packageName }}"]

{% else %}[tool.scikit-build]
wheel.packages = ["src/{{ packageName }}"]

{% endif %}[tool.ruff]
target-version = "py312"
line-length = 100

[tool.ruff.lint]
select = ["B", "E", "F", "I", "RUF", "UP"]

[tool.mypy]
python_version = "3.12"
strict = true
files = ["src/{{ packageName }}"]

[tool.pytest.ini_options]
addopts = "--strict-markers --strict-config"
markers = ["unit: isolated unit tests", "integration: external dependency tests", "e2e: end-to-end tests"]
